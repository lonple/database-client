# Local Docker Compose env — do not commit (gitignored: /deploy/dbc-docker.env).
# docker-deploy.cmd / docker-stop.cmd pass this file as: docker compose --env-file
# Scripts only rewrite the DBC_DOCKER_WORKSPACE line; keep other keys as you edit them.
#
# Layout:
#   E:/app/docker/workspace          Docker workspace root
#   E:/app/docker/workspace/dbc      this product (DBC_DOCKER_WORKSPACE)
#   E:/app/docker/workspace/dbc/<container>
#
# Copy to deploy/dbc-docker.env if missing, then fill values.

DBC_DOCKER_WORKSPACE=E:/app/docker/workspace/dbc

# ---- dbc-askdata (DashScope / Qwen) ----
# Prefer key here so it is not baked into the image. Empty = fall back to
# ${DBC_DOCKER_WORKSPACE}/secrets/askdata-llm-api-key.txt
DBC_ASKDATA_LLM_API_KEY=
DBC_ASKDATA_LLM_RESIDENCY=cloud
DBC_ASKDATA_LLM_PROVIDER=qwen
DBC_ASKDATA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# 模型名可留空，使用 providers/<provider>/profile.yaml
DBC_ASKDATA_LLM_MODEL=
DBC_ASKDATA_LLM_MODEL_LIGHT=
DBC_ASKDATA_LOG_LEVEL=INFO

# 浏览器会话（双令牌）：生产须设 Cookie Secure=true，并配置前端 Origin（网关 CORS 白名单见 application.yml）
# DBC_AUTH_COOKIE_SECURE=true
# DBC_AUTH_ACCESS_TTL_MINUTES=30
# DBC_AUTH_REFRESH_TTL_HOURS=8

# 知识库 / 图谱与 dbc-askdata 同在 dbc-net
DBC_ASKDATA_KNOWLEDGE_BASE_URL=http://dbc-knowledge:8010
DBC_ASKDATA_GRAPH_BASE_URL=http://dbc-graph:8011
DBC_ASKDATA_GRAPH_CODE=default
